#!/usr/bin/env bash

azure_remote_inspection() {
  "$ROOT/.venv/bin/python" "$ROOT/scripts/operations/azure/remote_inspection.py" "$@"
}

azure_image_tools() {
  [[ -x "$ROOT/.venv/bin/python" ]] || {
    demo_error 'Image verification requires the project Python 3.13 environment'; return 1;
  }
  "$ROOT/.venv/bin/python" -c 'import sys; sys.exit(0 if sys.version_info[:2] == (3,13) else 1)' || {
    demo_error 'Image verification requires Python 3.13'; return 1;
  }
}

azure_inspect_image() {
  local component="$1" reference="$2" api_base="$3" created="$4"
  local context request state key value expected context_id run_id digest layer expected_digest
  context="$AZURE_WORKSPACE/verification-$component"
  request="$context/request.json"
  azure_remote_inspection prepare --source "$SOURCE" --component "$component" \
    --reference "$reference" --revision "$REVISION" --api-base "$api_base" \
    --run-info "$AZURE_WORKSPACE/run-$component.json" --directory "$context" \
    > "$AZURE_WORKSPACE/verification-plan-$component.json" || return
  context_id=$(jq -er '.context_id' "$AZURE_WORKSPACE/verification-plan-$component.json") || return
  key=$(jq -er '.key' "$AZURE_WORKSPACE/verification-plan-$component.json") || return
  azure_registry || return
  azure_remote_inspection state --request "$request" \
    --registry-info "$AZURE_WORKSPACE/registry.json" \
    > "$AZURE_WORKSPACE/verification-state-$component.json" || return
  state=$(jq -er '.state' "$AZURE_WORKSPACE/verification-state-$component.json") || return
  if [[ "$INSPECT_ONLY" == true && "$state" != complete ]]; then
    demo_error 'Remote image verification is missing, pending or stale; run make build CONFIRM_AZURE=yes'
    return 1
  fi
  if [[ "$state" == missing || "$state" == stale ]]; then
    expected=$(jq -c '.value' "$AZURE_WORKSPACE/verification-state-$component.json") || return
    azure_merge_registry_receipt "$key" "pending-v1:$context_id" "$expected" || return
    demo_status section "Remote image verification: $component"
    (cd "$context" && TMPDIR="$AZURE_WORKSPACE" \
      demo_run "ACR verification: $component" az acr run \
      --subscription "$AZURE_SUBSCRIPTION_ID" --registry "$REGISTRY" \
      --platform linux/amd64 --source-acr-auth-id '[caller]' \
      --file verify.yaml --timeout 3600 --output none .) >&2 || {
      local result=$?
      demo_status error 'Remote verification failed; the candidate was not promoted.'
      return "$result"
    }
    state=pending
  fi
  if [[ "$state" == complete ]]; then
    run_id=$(jq -er '.runId' "$AZURE_WORKSPACE/verification-state-$component.json") || return
    expected_digest=$(jq -er '.digest' "$AZURE_WORKSPACE/verification-state-$component.json") || return
    azure_json acr task show-run --registry "$REGISTRY" --run-id "$run_id" \
      > "$AZURE_WORKSPACE/verification-run-$component.json" || return
    jq -e --arg runId "$run_id" --arg digest "$expected_digest" '
      (.properties // .) | .runId == $runId and .outputImages[0].digest == $digest
    ' "$AZURE_WORKSPACE/verification-run-$component.json" >/dev/null || {
      demo_error 'Remote verification receipt differs from the authenticated run'; return 1;
    }
  else
    azure_json acr task list-runs --registry "$REGISTRY" --top 1000 \
      > "$AZURE_WORKSPACE/verification-runs-$component.json" || return
    azure_remote_inspection resolve --request "$request" \
      --runs-info "$AZURE_WORKSPACE/verification-runs-$component.json" \
      > "$AZURE_WORKSPACE/verification-run-$component.json" || {
      demo_status error 'A verification receipt exists, but its completed run is not uniquely identifiable.'
      demo_status warning 'Inspect the original ACR verification run. No second verification was queued.'
      return 1
    }
  fi
  digest=$(jq -er '(.properties // .).outputImages[0].digest | select(test("^sha256:[a-f0-9]{64}$"))' \
    "$AZURE_WORKSPACE/verification-run-$component.json") || return
  azure_json acr manifest show --registry "$REGISTRY" --name "plane-$component@$digest" --raw \
    > "$AZURE_WORKSPACE/verification-manifest-$component.json" || return
  layer=$(jq -er '.layers | select(length == 1) | .[0].digest |
    select(test("^sha256:[a-f0-9]{64}$"))' "$AZURE_WORKSPACE/verification-manifest-$component.json") || return
  azure_pull_blob "plane-$component" "$layer" "$AZURE_WORKSPACE/verification-layer-$component" 2097152 || return
  azure_remote_inspection report --request "$request" \
    --run-info "$AZURE_WORKSPACE/verification-run-$component.json" \
    --manifest "$AZURE_WORKSPACE/verification-manifest-$component.json" \
    --layer "$AZURE_WORKSPACE/verification-layer-$component" \
    --receipt "$AZURE_WORKSPACE/verification-receipt-$component.json" \
    > "$AZURE_WORKSPACE/inspection-$component.json" || return
  if [[ "$created" == false ]]; then
    # Docker export metadata is engine-specific. Retain the immutable image/build/source
    # binding; the authenticated remote report records its own filesystem measurement.
    jq -e --slurpfile recorded "$AZURE_WORKSPACE/provenance-$component.json" '
      [.provenance.policy, .provenance.run_id, .provenance.digest, .provenance.source_fingerprint]
      == [$recorded[0].policy, $recorded[0].run_id, $recorded[0].digest,
          $recorded[0].source_fingerprint]
    ' "$AZURE_WORKSPACE/inspection-$component.json" >/dev/null || {
      demo_error 'trusted_image_build_or_source_mismatch'; return 1;
    }
  fi
  if [[ "$state" != complete ]]; then
    value=$(jq -er '.value' "$AZURE_WORKSPACE/verification-receipt-$component.json") || return
    expected=$(jq -cn --arg value "pending-v1:$context_id" '$value') || return
    azure_merge_registry_receipt "$key" "$value" "$expected" || return
  fi
  demo_status success "Remote image verification: $component contents verified"
}
